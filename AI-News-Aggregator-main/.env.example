ENVIRONMENT=development

# Database Settings (PostgreSQL or SQLite fallback)
DATABASE_URL=sqlite:///./news_aggregator.db

# ChromaDB Vector Store Settings (Local persistent directory)
CHROMA_PERSIST_DIR=./chroma_db

# Security & JWT Authentication
JWT_SECRET=your_secure_jwt_secret_key_here

# LLM API Keys (Groq is 100% free at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_optional_gemini_key

# Email Delivery (Gmail SMTP with 16-char App Password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_APP_PASSWORD=your_16_char_app_password
RECIPIENT_EMAIL=your_email@gmail.com

# 1. Google Custom Search JSON API
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# 2. Brave Search API
BRAVE_API_KEY=
